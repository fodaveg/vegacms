<!doctype html><html lang="es" data-theme="niebla" data-density="comfortable"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vega · crear desde una relación · propuesta L12</title><style>{{CSS}}</style></head><body>
<div class="lab"><strong>Vega · L12 · mockup</strong><label>Idioma / Language <select id="language"><option value="es">Español</option><option value="en">English</option></select></label><label>Tema <select id="theme"><option>niebla</option><option>miel</option><option>aquelarre</option></select></label><label>Modo <select id="mode"><option value="system">Sistema</option><option value="light">Claro</option><option value="dark">Oscuro</option></select></label><label>Estado <select id="scenario"><option value="normal">Flujo normal</option><option value="empty">Vacío</option><option value="long">Texto largo</option><option value="loading">Guardando</option><option value="validation">Campo obligatorio</option><option value="duplicate">Dirección duplicada</option><option value="network">Resultado incierto</option><option value="readonly">Campo solo lectura</option><option value="denied">Sin permiso de crear</option><option value="hidden">Creación oculta</option><option value="limit">Límite de selección</option></select></label><small data-copy="mockup"></small></div>
<div id="parent-screen"><header class="topbar"><strong>Vega</strong><span>fodaveg.net</span></header><div class="layout"><aside class="sidebar"><p>Entradas</p><p>Etiquetas</p><p>Medios</p><p>Ajustes</p></aside><main class="workspace"><header class="editbar"><h1>Entradas</h1><span class="dirty" data-copy="dirty"></span><button type="button" class="vega-admin-btn save-parent" data-copy="saveParent"></button></header><div class="field-card"><div class="field"><label for="parent-title" data-copy="title"></label><textarea id="parent-title" class="title-input">Migrar el blog de Hugo a Astro sin romper las URLs</textarea></div><div class="field"><label for="search">Etiquetas</label><div class="relation"><div id="selected" class="selected"></div><input id="search" class="vega-admin-input" value="Taller"><p id="search-status" class="status" aria-live="polite"></p><div class="create-row"><button id="open-create" type="button" class="vega-admin-btn"></button></div><p id="relation-help" class="help"></p></div></div><div id="success" class="success" role="status" hidden></div></div></main></div></div>
<div class="backdrop" id="modal" hidden><section class="vega-admin-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-describedby="modal-note"><header class="vega-admin-dialog-head"><h2 id="modal-title"></h2><button class="vega-admin-icon-btn" id="close" aria-label="Cerrar">×</button></header><p class="vega-admin-dialog-text" data-copy="returnTo"></p><form id="child-form" class="vega-admin-form" novalidate><div id="child-fields"><div class="vega-admin-field"><label for="name" data-copy="name"></label><input id="name" class="vega-admin-input" maxlength="80" required><p id="name-error" class="vega-admin-field-error" hidden></p></div><div class="vega-admin-field"><label for="slug">Dirección (slug) *</label><input id="slug" class="vega-admin-input" maxlength="80" required><p class="vega-admin-help" data-copy="slugHelp"></p><p id="slug-error" class="vega-admin-field-error" hidden></p></div></div><div id="duplicate" class="duplicate" hidden><p data-copy="duplicate"></p><button id="use-existing" class="vega-admin-btn" type="button" data-copy="useExisting"></button></div><p id="form-error" class="form-message" role="alert" hidden></p><p class="modal-note" id="modal-note" data-copy="independent"></p><div id="discard" hidden><p data-copy="discardBody"></p></div><div class="vega-admin-dialog-actions"><button id="cancel" class="vega-admin-btn" type="button" data-copy="cancel"></button><button id="submit" class="vega-admin-btn vega-admin-btn--primary primary" type="submit" data-copy="create"></button></div></form></section></div>
<script>{{SCRIPT}}</script></body></html>
