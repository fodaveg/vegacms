<!doctype html><html lang="es" data-theme="niebla" data-density="comfortable"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vega · enlaces de vista previa · propuesta</title><style>{{CSS}}</style></head><body><div class="lab"><strong>Vega · preview compartida · mockup</strong><label>Idioma <select id="language"><option value="es">Español</option><option value="en">English</option></select></label><label>Tema <select id="theme"><option>niebla</option><option>miel</option><option>aquelarre</option></select></label><label>Modo <select id="mode"><option value="system">Sistema</option><option value="light">Claro</option><option value="dark">Oscuro</option></select></label><label>Estado <select id="scenario"><option value="normal">Normal</option><option value="dirty">Sin guardar</option><option value="empty">Sin enlaces</option><option value="expired">Caduca mientras está abierto</option><option value="revoked">Anulado en esta sesión</option><option value="long">Etiqueta larga</option><option value="loading">Cargando lista</option><option value="busy">Creando</option><option value="error">Error de servidor</option><option value="ttl">Duración rechazada</option><option value="uncertain">Creación incierta</option><option value="denied">Sin permiso de edición</option><option value="new">Registro nuevo</option><option value="unsupported">Sin preview.share</option></select></label><small data-copy="mockup"></small></div>
<div id="parent-screen"><header class="topbar"><strong>Vega</strong><span>fodaveg.net</span></header><div class="layout"><aside class="sidebar"><p class="active">Páginas</p><p>Entradas</p><p>Medios</p><p>Ajustes</p></aside><main class="workspace"><header class="editbar"><h1>Sobre mí</h1><span id="saved-state"></span><div class="actions"><button class="vega-admin-btn" id="open" data-copy="open"></button><button class="vega-admin-btn" data-copy="save"></button></div></header><div class="field-card"><h2>Sobre mí</h2><p>/sobre-mi</p><p id="availability" hidden></p></div></main></div></div>
<div class="backdrop" id="modal" hidden><section class="vega-admin-dialog" role="dialog" aria-modal="true" aria-labelledby="dialog-title" aria-describedby="context"><header class="vega-admin-dialog-head"><h2 id="dialog-title"></h2><button id="close" class="vega-admin-icon-btn" aria-label="Cerrar">×</button></header><p class="context" id="context">Sobre mí · /sobre-mi</p><div class="notice" id="dirty-notice" data-copy="dirtyNotice" hidden></div>
<div id="manage" class="view"><p class="vega-admin-dialog-text" data-copy="scope"></p><p id="load-status" class="status" hidden></p><div id="list-error" class="error" hidden><p data-copy="listError"></p><button id="retry" class="vega-admin-btn" data-copy="retry"></button></div><div id="link-row" class="link-row"><h3 id="link-label">Ana (client)</h3><div class="link-meta"><span id="created"></span><span id="expires"></span></div><div class="row-foot"><span class="state-label" id="link-state"></span><button class="vega-admin-btn" id="revoke" data-copy="revoke"></button></div></div><div id="empty" class="empty" hidden><h3 data-copy="emptyTitle"></h3><p class="status" data-copy="emptyBody"></p></div><p class="success" id="revoked-notice" data-copy="revoked" hidden></p><p class="close-note" data-copy="listNoUrl"></p><div class="vega-admin-dialog-actions"><button id="done" class="vega-admin-btn" data-copy="close"></button><button id="new-link" class="vega-admin-btn vega-admin-btn--primary primary" data-copy="newLink"></button></div></div>
<form id="create" class="view" novalidate hidden><div class="vega-admin-field"><label for="label" data-copy="label"></label><input id="label" class="vega-admin-input" maxlength="120"><p class="vega-admin-help" data-copy="labelHelp"></p></div><div class="vega-admin-field"><label for="quantity" data-copy="duration"></label><div class="duration"><input id="quantity" class="vega-admin-input" inputmode="numeric" type="number" step="1" value="1"><select id="unit" class="vega-admin-input" aria-label="Unidad de duración"><option value="86400" data-copy="days"></option><option value="3600" data-copy="hours"></option><option value="60" data-copy="minutes"></option><option value="1" data-copy="seconds"></option></select></div><p class="vega-admin-help" data-copy="durationHelp"></p><p id="ttl-error" class="vega-admin-field-error" hidden></p></div><p class="note" data-copy="publicScope"></p><div id="create-error" class="error" role="alert" hidden></div><div class="vega-admin-dialog-actions"><button type="button" id="back" class="vega-admin-btn" data-copy="cancel"></button><button type="submit" id="create-submit" class="vega-admin-btn vega-admin-btn--primary primary" data-copy="create"></button></div></form>
<div id="success" class="view" hidden><p class="success" data-copy="createdSuccess"></p><p class="status" id="new-expires"></p><div class="vega-admin-field"><label for="url" data-copy="url"></label><textarea id="url" class="vega-admin-input url" readonly spellcheck="false"></textarea></div><p class="note" data-copy="oneTime"></p><p class="status" id="copy-status" role="status"></p><div class="vega-admin-dialog-actions"><button id="success-close" class="vega-admin-btn" data-copy="close"></button><button id="copy" class="vega-admin-btn vega-admin-btn--primary primary" data-copy="copy"></button></div></div>
<div id="close-confirm" class="view" hidden><p data-copy="closeWarning"></p><div class="vega-admin-dialog-actions"><button id="keep" class="vega-admin-btn primary" data-copy="keep"></button><button id="lose" class="vega-admin-btn" data-copy="closeLose"></button></div></div>
<div id="revoke-confirm" class="view" hidden><p><strong id="revoke-label"></strong></p><p class="vega-admin-dialog-text" data-copy="revokeWarning"></p><div id="revoke-error" class="error" role="alert" hidden></div><div class="vega-admin-dialog-actions"><button id="revoke-cancel" class="vega-admin-btn" data-copy="cancel"></button><button id="revoke-submit" class="vega-admin-btn vega-admin-btn--danger primary" data-copy="revokeConfirm"></button></div></div></section></div><script>{{SCRIPT}}</script></body></html>
