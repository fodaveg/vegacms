# Caddy INTERNO del contenedor `lumbre-web`: solo sirve ficheros estáticos por
# HTTP en la red Docker `edge`. El TLS, HSTS y el dominio los pone el borde
# compartido (`/srv/edge`), que hace de reverse_proxy contra este puerto; por eso
# aquí `auto_https off` y ningún puerto publicado al host.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv/site
	encode zstd gzip

	# Astro genera discovery sin extensión; su contenido sigue siendo JSON.
	@vegaDiscovery path /api/vega/discovery
	header @vegaDiscovery Content-Type application/json

	file_server

	# El build de Astro pone un hash en el nombre de todo lo de `/_astro/`, así
	# que se puede cachear para siempre. Las fuentes son ficheros fijos servidos
	# desde `public/`: no llevan hash, pero tampoco cambian sin cambiar de
	# nombre. El HTML NO se cachea: es lo que hay que revalidar en cada deploy
	# para que la página apunte a los assets nuevos.
	@immutable path /_astro/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@revalidate not path /_astro/* /fonts/*
	header @revalidate Cache-Control "public, max-age=0, must-revalidate"

	header -Server
}
